{
  "name": "pet-alert",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*"
  ],
  "prisma": {
    "seed": "dotenv -e .env -- tsx packages/shared/prisma/seed.ts"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset --schema packages/shared/prisma/schema.prisma",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema packages/shared/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema packages/shared/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy --schema packages/shared/prisma/schema.prisma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lautigrz/pet_alert.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lautigrz/pet_alert/issues"
  },
  "homepage": "https://github.com/lautigrz/pet_alert#readme",
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-turbo": "^2.9.12",
    "prisma": "^6.19.3",
    "turbo": "^2.9.12",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "onnxruntime-node": "^1.26.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "unzipper": "^0.12.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ioredis": "5.10.1"
  }
}
