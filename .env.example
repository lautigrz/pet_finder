# .env raiz
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db"
REDIS_URL=

# .env en el paquete api
PORT=
NODE_ENV=
CORS_ORIGIN=
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (CU-1.7B). provider=log (default) solo loguea el link en consola.
# provider=gmail manda de verdad via SMTP de Gmail (requiere App Password con 2FA).
EMAIL_PROVIDER=log
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:4200

# Pagos - Mercado Pago Checkout Pro.
# MP_ACCESS_TOKEN: credencial privada (usar el token de prueba en desarrollo).
# MP_WEBHOOK_SECRET: clave secreta para validar la firma del webhook.
# PUBLIC_API_URL: URL publica del backend para el notification_url (en desarrollo, la de ngrok).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:3000
FEATURED_PRICE=180
FEATURED_CURRENCY=ARS
# Validacion de firma del webhook. true (default) en produccion.
# En desarrollo local, MP firma los pagos live_mode con un secret que el panel no expone,
# asi que se puede poner en false: el pago igual se verifica contra la API de MP.
MP_VALIDATE_WEBHOOK_SIGNATURE=true

