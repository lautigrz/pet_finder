# .env raiz
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db"
REDIS_URL=

# .env en el paquete api
PORT=
NODE_ENV=
CORS_ORIGIN=
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (CU-1.7B). provider=log (default) solo loguea el link en consola.
# provider=gmail manda de verdad via SMTP de Gmail (requiere App Password con 2FA).
EMAIL_PROVIDER=log
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:4200

