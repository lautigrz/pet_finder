generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

model Role {
  role_id Int    @id @default(autoincrement()) @db.SmallInt
  name    String @db.Char(20)

  users User[]

  @@map("roles")
}

model User {
  user_id   Int     @id @default(autoincrement())
  public_id String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String? @db.VarChar
  lastname  String? @db.VarChar
  email     String  @unique @db.VarChar(255)
  username  String  @db.VarChar(30)
  password  String  @db.VarChar(100)

  role_id Int?
  role    Role? @relation(fields: [role_id], references: [role_id])

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)

  is_verified  Boolean @default(false)
  is_suspended Boolean @default(false)
  exp          Int     @default(0)
  photo_url    String? @db.VarChar

  refresh_tokens            RefreshToken[]
  password_reset_tokens     PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  reports                   Report[]
  pets                      Pet[]
  messages_sent             Message[]                @relation("MessageSender")
  messages_received         Message[]                @relation("MessageReceiver")
  conversations_one         Conversation[]           @relation("ConversationUserOne")
  conversations_two         Conversation[]           @relation("ConversationUserTwo")
  notification_preference   NotificationPreference?
  device_tokens             DeviceToken[]
  report_followers          ReportFollower[]
  content_reports           ContentReport[]
  match_views               MatchView[]
  payments                  Payment[]
  appeals                   Appeal[]
  reviews_written           UserReview[]              @relation("ReviewsWritten")
  reviews_received          UserReview[]              @relation("ReviewsReceived")

  @@map("users")
}

model RefreshToken {
  refresh_token_id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id])

  token String @unique @db.VarChar

  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6) /// NULL si el token sigue activo. Se setea al hacer logout o al rotar el token
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  password_reset_token_id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id])

  token String @db.VarChar

  used_at    DateTime? @db.Timestamp(6) /// NULL si no fue usado. Se setea al momento en que el usuario resetea la contraseña
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  email_verification_token_id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [user_id])

  token String @unique @db.VarChar

  used_at    DateTime? @db.Timestamp(6) /// NULL si no fue usado. Se setea cuando el usuario confirma el email
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@map("email_verification_tokens")
}

model Report {
  report_id        Int     @id @default(autoincrement())
  public_id        String  @unique @db.Uuid
  user_id          Int
  report_type_id   Int     @db.SmallInt
  report_status_id Int     @db.SmallInt
  description      String? @db.Text

  closed_by_moderation Boolean @default(false)
  resolved             Boolean @default(false)
  resolved_at          DateTime? @db.Timestamp(6)

  occurred_at DateTime

  location_address String?
  location_lat     Decimal
  location_lng     Decimal

  created_at DateTime  @db.Timestamp(6)
  updated_at DateTime? @updatedAt

  featured Boolean @default(false)

  embedding_description Unsupported("vector(384)")?

  user                   User                  @relation(fields: [user_id], references: [user_id])
  reportType             ReportType            @relation(fields: [report_type_id], references: [report_type_id])
  reportStatus           ReportStatus          @relation(fields: [report_status_id], references: [report_status_id])
  lost_report_detail     LostReportDetail?
  sighting_report_detail SightingReportDetail?
  reportImages           ReportImage[]
  report_followers       ReportFollower[]

  matchResults MatchResult[] @relation("SourceReport")

  matchedAsCandidate MatchResult[] @relation("CandidateReport")

  payments Payment[]

  @@map("reports")
}

model Payment {
  payment_id       Int    @id @default(autoincrement())
  public_id        String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id        Int
  user_id          Int
  mp_preference_id String?
  mp_payment_id    String? @unique
  status           String
  amount           Decimal @db.Decimal(12, 2)
  currency         String  @default("ARS")

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)

  report Report @relation(fields: [report_id], references: [report_id])
  user   User   @relation(fields: [user_id], references: [user_id])

  @@index([report_id])
  @@index([user_id])
  @@map("payments")
}

model MatchResult {
  match_result_id     Int    @id @default(autoincrement())
  public_id           String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_report_id    Int
  candidate_report_id Int

  score             Float
  image_score       Float
  description_score Float
  structured_score  Float
  shared_fields     Int

  created_at DateTime @default(now()) @db.Timestamp(6)

  source_report    Report @relation("SourceReport", fields: [source_report_id], references: [report_id])
  candidate_report Report @relation("CandidateReport", fields: [candidate_report_id], references: [report_id])
  views            MatchView[]

  @@unique([source_report_id, candidate_report_id])
  @@index([source_report_id])
  @@index([score])
  @@map("match_results")
}

model MatchView {
  match_view_id   Int      @id @default(autoincrement())
  user_id         Int
  match_result_id Int
  seen_at         DateTime @default(now()) @db.Timestamp(6)

  user         User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  match_result MatchResult @relation(fields: [match_result_id], references: [match_result_id], onDelete: Cascade)

  @@unique([user_id, match_result_id])
  @@index([user_id])
  @@index([match_result_id])
  @@map("match_views")
}

model ReportStatus {
  report_status_id Int    @id @db.SmallInt
  name             String

  reports Report[]

  @@map("report_statuses")
}

model ReportType {
  report_type_id Int    @id @db.SmallInt
  name           String

  reports Report[]

  @@map("report_types")
}

model LostReportDetail {
  report_id Int @id
  pet_id    Int

  report Report @relation(fields: [report_id], references: [report_id])
  pet    Pet    @relation(fields: [pet_id], references: [pet_id])

  @@map("lost_report_details")
}

model SightingReportDetail {
  report_id      Int        @id
  animal_type_id Int
  color_id       Int        @db.SmallInt
  pet_name       String?    @db.VarChar(30)
  gender_id      Int?       @db.SmallInt
  size_id        Int?       @db.SmallInt
  has_id_collar  Boolean    @default(false)
  is_in_transit  Boolean    @default(false)
  breed_id       Int?       @db.SmallInt
  report         Report     @relation(fields: [report_id], references: [report_id])
  animal_type    AnimalType @relation(fields: [animal_type_id], references: [animal_type_id])
  gender         Gender?    @relation(fields: [gender_id], references: [gender_id])
  size           PetSize?   @relation(fields: [size_id], references: [size_id])
  color          Color      @relation(fields: [color_id], references: [color_id])
  breed          Breed?     @relation(fields: [breed_id], references: [breed_id])

  @@map("sighting_report_details")
}

model Pet {
  pet_id         Int       @id @default(autoincrement())
  public_id      String    @unique @db.Uuid
  user_id        Int
  animal_type_id Int
  gender_id      Int       @db.SmallInt
  size_id        Int       @db.SmallInt
  pet_name       String    @db.VarChar(30)
  color_id       Int       @db.SmallInt
  has_id_collar  Boolean   @default(false)
  is_vaccinated  Boolean   @default(false)
  breed_id       Int?      @db.SmallInt
  created_at     DateTime  @db.Timestamp(6)
  updated_at     DateTime? @updatedAt

  user                User               @relation(fields: [user_id], references: [user_id])
  animal_type         AnimalType         @relation(fields: [animal_type_id], references: [animal_type_id])
  gender              Gender             @relation(fields: [gender_id], references: [gender_id])
  size                PetSize            @relation(fields: [size_id], references: [size_id])
  color               Color              @relation(fields: [color_id], references: [color_id])
  breed               Breed?             @relation(fields: [breed_id], references: [breed_id])
  petImages           PetImage[]
  lost_report_details LostReportDetail[]

  @@map("pets")
}

model PetImage {
  imageId         Int                         @id @default(autoincrement()) @map("image_id")
  cloudinaryId    String                      @unique @map("cloudinary_id")
  petId           Int                         @map("pet_id")
  photoUrl        String                      @map("photo_url") @db.VarChar(500)
  createdAt       DateTime                    @default(now()) @map("created_at")
  embedding_photo Unsupported("vector(384)")?
  pet             Pet                         @relation(fields: [petId], references: [pet_id])

  @@map("pet_images")
}

model ReportImage {
  imageId         Int                         @id @default(autoincrement()) @map("image_id")
  cloudinaryId    String                      @unique @map("cloudinary_id")
  reportId        Int                         @map("report_id")
  photoUrl        String                      @map("photo_url") @db.VarChar(500)
  createdAt       DateTime                    @default(now()) @map("created_at")
  embedding_photo Unsupported("vector(384)")?
  report          Report                      @relation(fields: [reportId], references: [report_id])

  @@map("report_images")
}

model AnimalType {
  animal_type_id Int    @id @db.SmallInt
  name           String @db.VarChar(50)

  sighting_report_details SightingReportDetail[]
  pets                    Pet[]
  breeds                  Breed[]

  @@map("animal_types")
}

model Breed {
  breed_id       Int    @id @default(autoincrement()) @db.SmallInt
  name           String @db.VarChar(100)
  animal_type_id Int    @db.SmallInt

  animal_type AnimalType @relation(fields: [animal_type_id], references: [animal_type_id])

  pets                    Pet[]
  sighting_report_details SightingReportDetail[]

  @@unique([name, animal_type_id])
  @@map("breeds")
}

model Color {
  color_id Int    @id @default(autoincrement()) @db.SmallIntf
  name     String @unique @db.VarChar(150)

  pets                    Pet[]
  sighting_report_details SightingReportDetail[]

  @@map("colors")
}

model Gender {
  gender_id               Int                    @id @db.SmallInt
  name                    String                 @db.VarChar(30)
  pets                    Pet[]
  sighting_report_details SightingReportDetail[]

  @@map("genders")
}

model PetSize {
  size_id                 Int                    @id @db.SmallInt
  name                    String                 @db.VarChar(50)
  pets                    Pet[]
  sighting_report_details SightingReportDetail[]

  @@map("pet_sizes")
}

model NotificationPreference {
  notification_preference_id Int       @id @default(autoincrement())
  user_id                    Int       @unique
  notification_radius        Int       @default(5)
  lost_reports_enabled       Boolean   @default(true)
  sighting_reports_enabled   Boolean   @default(true)
  matches_enabled            Boolean   @default(true)
  notifications_muted_until  DateTime? @db.Timestamp(6)
  created_at                 DateTime  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("notification_preferences")
}

model DeviceToken {
  device_token_id Int      @id @default(autoincrement())
  user_id         Int
  token           String   @unique @db.VarChar(512)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("device_tokens")
}

model Message {
  message_id       Int      @id @default(autoincrement())
  public_id        String   @unique @db.Uuid
  message_text     String   @db.Text
  is_read          Boolean  @default(false)
  sender_user_id   Int
  receiver_user_id Int
  conversation_id  Int
  created_at       DateTime @default(now()) @db.Timestamp(6)

  senderUser   User           @relation(fields: [sender_user_id], references: [user_id], onDelete: Cascade, name: "MessageSender")
  receiverUser User           @relation(fields: [receiver_user_id], references: [user_id], onDelete: Cascade, name: "MessageReceiver")
  conversation Conversation   @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  images       MessageImage[]

  @@index([conversation_id])
  @@index([sender_user_id])
  @@index([receiver_user_id])
  @@map("messages")
}

model Conversation {
  conversation_id Int      @id @default(autoincrement())
  public_id       String   @unique @db.Uuid
  user_one_id     Int
  user_two_id     Int
  created_at      DateTime @default(now()) @db.Timestamp(6)
  is_suspended    Boolean  @default(false)

  user_one User      @relation(fields: [user_one_id], references: [user_id], onDelete: Cascade, name: "ConversationUserOne")
  user_two User      @relation(fields: [user_two_id], references: [user_id], onDelete: Cascade, name: "ConversationUserTwo")
  messages Message[]

  @@unique([user_one_id, user_two_id])
  @@index([user_one_id])
  @@index([user_two_id])
  @@map("conversations")
}

model MessageImage {
  image_id   Int      @id @default(autoincrement())
  public_id  String   @unique @db.Uuid
  photoUrl   String   @map("photo_url") @db.VarChar(500)
  message_id Int
  created_at DateTime @default(now()) @db.Timestamp(6)

  message Message @relation(fields: [message_id], references: [message_id], onDelete: Cascade)

  @@index([message_id])
  @@map("message_images")
}

model ReportFollower {
  report_follower_id Int      @id @default(autoincrement())
  user_id            Int
  report_id          Int
  created_at         DateTime @default(now()) @db.Timestamp(6)

  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  report Report @relation(fields: [report_id], references: [report_id], onDelete: Cascade)

  @@unique([user_id, report_id])
  @@index([user_id])
  @@index([report_id])
  @@map("report_followers")
}

model ContentReport {
  content_report_id Int      @id @default(autoincrement())
  public_id         String   @unique @db.Uuid
  reporter_user_id  Int
  target_type_id    Int      @db.SmallInt
  target_public_id  String   @db.Uuid
  reason_id         Int      @db.SmallInt
  status_id         Int      @db.SmallInt
  description       String?  @db.Text
  suspension_reason String?  @db.Text
  auto_flagged      Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamp(6)

  reporter   User                    @relation(fields: [reporter_user_id], references: [user_id], onDelete: Cascade)
  targetType ContentReportTargetType @relation(fields: [target_type_id], references: [content_report_target_type_id])
  reason     ContentReportReason     @relation(fields: [reason_id], references: [content_report_reason_id])
  status     ContentReportStatus     @relation(fields: [status_id], references: [content_report_status_id])

  @@unique([reporter_user_id, target_type_id, target_public_id])
  @@index([target_type_id, target_public_id])
  @@index([status_id])
  @@map("content_reports")
}

model ContentReportTargetType {
  content_report_target_type_id Int    @id @db.SmallInt
  name                          String

  content_reports ContentReport[]

  @@map("content_report_target_types")
}

model ContentReportReason {
  content_report_reason_id Int    @id @db.SmallInt
  name                     String

  content_reports ContentReport[]

  @@map("content_report_reasons")
}

model ContentReportStatus {
  content_report_status_id Int    @id @db.SmallInt
  name                     String

  content_reports ContentReport[]

  @@map("content_report_statuses")
}

model Appeal {
  appeal_id         Int       @id @default(autoincrement())
  public_id         String    @unique @db.Uuid
  appellant_user_id Int
  target_type_id    Int       @db.SmallInt
  target_public_id  String    @db.Uuid
  message           String    @db.Text
  status_id         Int       @db.SmallInt
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  resolved_at       DateTime? @db.Timestamp(6)

  appellant  User             @relation(fields: [appellant_user_id], references: [user_id], onDelete: Cascade)
  targetType AppealTargetType @relation(fields: [target_type_id], references: [appeal_target_type_id])
  status     AppealStatus     @relation(fields: [status_id], references: [appeal_status_id])

  @@unique([target_type_id, target_public_id])
  @@index([status_id])
  @@map("appeals")
}

model AppealTargetType {
  appeal_target_type_id Int    @id @db.SmallInt
  name                  String

  appeals Appeal[]

  @@map("appeal_target_types")
}

model AppealStatus {
  appeal_status_id Int    @id @db.SmallInt
  name             String

  appeals Appeal[]

  @@map("appeal_statuses")
}

model UserReview {
  user_review_id   Int      @id @default(autoincrement())
  reviewer_user_id Int
  reviewed_user_id Int
  rating           Int      @db.SmallInt
  description      String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  reviewer User @relation("ReviewsWritten", fields: [reviewer_user_id], references: [user_id], onDelete: Cascade)
  reviewed User @relation("ReviewsReceived", fields: [reviewed_user_id], references: [user_id], onDelete: Cascade)

  @@unique([reviewer_user_id, reviewed_user_id])
  @@index([reviewed_user_id])
  @@index([reviewer_user_id])
  @@map("user_reviews")
}