{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@application/*": [
        "./src/application/*"
      ],
      "src/*": [
        "./src/*"
      ]
    }
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}