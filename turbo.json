{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false,
      "env": [
        "NODE_ENV",
        "PORT",
        "CORS_ORIGIN",
        "REDIS_HOST",
        "REDIS_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "CLOUDINARY_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "EMAIL_PROVIDER",
        "GMAIL_USER",
        "GMAIL_APP_PASSWORD",
        "SENDGRID_API_KEY",
        "EMAIL_FROM",
        "APP_BASE_URL",
        "MP_ACCESS_TOKEN",
        "MP_WEBHOOK_SECRET",
        "PUBLIC_API_URL",
        "FEATURED_PRICE",
        "FEATURED_CURRENCY",
        "MP_VALIDATE_WEBHOOK_SIGNATURE",
        "LOG_LEVEL",
        "LOG_DIR"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "outputs": [],
      "env": [
        "NODE_ENV",
        "PORT",
        "CORS_ORIGIN",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "DATABASE_URL",
        "REDIS_URL",
        "CLOUDINARY_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "EMAIL_PROVIDER",
        "GMAIL_USER",
        "GMAIL_APP_PASSWORD",
        "SENDGRID_API_KEY",
        "EMAIL_FROM",
        "APP_BASE_URL",
        "MP_ACCESS_TOKEN",
        "MP_WEBHOOK_SECRET",
        "PUBLIC_API_URL",
        "FEATURED_PRICE",
        "FEATURED_CURRENCY",
        "MP_VALIDATE_WEBHOOK_SIGNATURE",
        "LOG_LEVEL",
        "LOG_DIR"
      ]
    }
  }
}