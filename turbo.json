{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "env": ["NODE_ENV", "PORT", "CORS_ORIGIN", "REDIS_HOST", "REDIS_PORT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": [],
      "env": ["NODE_ENV", "PORT", "CORS_ORIGIN", "REDIS_HOST", "REDIS_PORT"]
    }
  }
}